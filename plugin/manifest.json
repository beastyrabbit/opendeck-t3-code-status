{
	"Name": "T3 Code Status",
	"Description": "Shows working T3 Code threads and the approvals, questions, plan reviews, failures, and usage limits that need you, across all connected environments.",
	"Author": "BeastyRabbit",
	"Version": "0.4.1.0",
	"UUID": "com.beastyrabbit.t3-code-status",
	"URL": "https://github.com/beastyrabbit/opendeck-t3-code-status",
	"CodePath": "bin/plugin.cjs",
	"Icon": "icons/plugin",
	"Category": "T3 Code Status",
	"CategoryIcon": "icons/category",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.5"
	},
	"OS": [
		{
			"Platform": "linux"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "10.15"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"Actions": [
		{
			"Name": "Thread status",
			"UUID": "com.beastyrabbit.t3-code-status.overview",
			"Icon": "icons/action",
			"Tooltip": "Shows the status of T3 Code threads. Choose a status and a theme in the key settings.",
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
			"DisableAutomaticStates": true,
			"UserTitleEnabled": false,
			"PropertyInspectorPath": "property-inspector/index.html",
			"States": [
				{
					"FontSize": 0,
					"Image": "icons/action",
					"Title": "Loading T3 Code status",
					"TitleAlignment": "middle",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Overview",
			"UUID": "com.beastyrabbit.t3-code-status.overview-tile",
			"Icon": "icons/action",
			"Tooltip": "Shows working threads, what needs you, failures, and usage limits or background tasks on one key.",
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
			"DisableAutomaticStates": true,
			"UserTitleEnabled": false,
			"PropertyInspectorPath": "property-inspector/index.html",
			"States": [
				{
					"FontSize": 0,
					"Image": "icons/action",
					"Title": "Loading T3 Code status",
					"TitleAlignment": "middle",
					"ShowTitle": false
				}
			]
		}
	]
}
